{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "studySeconds": {
          "type": "number",
          "description": "Total active study time accumulated in seconds"
        },
        "lastActiveAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of the user's last interaction"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the user is actively working in a session"
        }
      },
      "required": [
        "userId",
        "email"
      ]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Bookmarked questions for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "questionId": {
          "type": "string",
          "maxLength": 128
        },
        "kurulId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "userId",
        "questionId"
      ]
    },
    "UserExamResult": {
      "title": "UserExamResult",
      "description": "Saved exam session statistics for user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "kurulId": {
          "type": "string",
          "maxLength": 64
        },
        "donem": {
          "type": "string",
          "maxLength": 32
        },
        "totalQuestions": {
          "type": "number"
        },
        "correctCount": {
          "type": "number"
        },
        "wrongCount": {
          "type": "number"
        },
        "emptyCount": {
          "type": "number"
        },
        "score": {
          "type": "number"
        },
        "completedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "userId",
        "totalQuestions",
        "correctCount"
      ]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "Server-managed subscription state for a user account (read-only for clients)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "plan": {
          "type": "string",
          "enum": ["free", "monthly", "semester", "yearly", "lifetime"]
        },
        "status": {
          "type": "string",
          "enum": ["inactive", "trialing", "active", "past_due", "canceled", "expired"]
        },
        "provider": {
          "type": "string",
          "enum": ["none", "iyzico", "stripe", "paddle", "lemonsqueezy", "manual"]
        },
        "providerCustomerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerSubscriptionId": {
          "type": "string",
          "maxLength": 128
        },
        "currentPeriodStart": {
          "type": "string",
          "maxLength": 64
        },
        "currentPeriodEnd": {
          "type": "string",
          "maxLength": 64
        },
        "trialEndsAt": {
          "type": "string",
          "maxLength": 64
        },
        "cancelAtPeriodEnd": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "userId",
        "plan",
        "status",
        "provider"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing basic user account details."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "UserBookmark",
      "description": "Collection of saved bookmarked questions for the user."
    },
    "/users/{userId}/examResults/{resultId}": {
      "schema": "UserExamResult",
      "description": "Exam and trial session history and scores for the user."
    },
    "/users/{userId}/subscription/{subId}": {
      "schema": "UserSubscription",
      "description": "Server-managed subscription document (canonical ID: current). Read-only for clients."
    }
  }
}
